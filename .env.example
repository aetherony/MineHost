
# Configurações do MineHost

NODE_ENV=development
PORT=3000

# Frontend
FRONTEND_URL=http://localhost:5500

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minehost
DB_USER=minehost_user
DB_PASSWORD=coloque_sua_senha_aqui
DB_SSL=false

# Segurança
SESSION_SECRET=troque_por_uma_chave_segura
